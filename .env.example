# Скопируйте в .env.local и заполните. Файл .env.local в git не попадает.

# --- База данных (Turso) ---
# Локальная разработка: файл рядом с проектом, ключи не нужны.
TURSO_DATABASE_URL=file:local.db
# Для продакшена: URL вида libsql://<db>-<org>.turso.io и токен из `turso db tokens create <db>`
TURSO_AUTH_TOKEN=

# --- Авторизация (better-auth) ---
# Случайная строка от 32 символов: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Адрес сайта ---
# Канонический адрес для Open Graph; на проде укажите свой домен.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI-ментор (Claude API), этап 7 ---
ANTHROPIC_API_KEY=

# --- Оплата PRO (Stripe, тестовый режим), этап 10 ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
